{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Ronde de Cadeaux",
            "type": "debugpy",
            "request": "launch",
            "module": "ronde_de_cadeaux.cli",
            "args": [
                "--test-mail",
                "--auth",
                "./private/mail_auth.yaml",
                "--message",
                "./private/message.html",
                "--plain-text",
                "--input",
                "./private/data.yaml",
                "--show",
                "--output",
                "./private/output.txt",
                "--force",
            ],
            "cwd": "${workspaceFolder}",
        },
    ]
}