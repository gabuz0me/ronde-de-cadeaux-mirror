{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Ronde de Cadeaux",
            "type": "debugpy",
            "request": "launch",
            "module": "ronde_de_cadeaux.cli",
            "args": [
                "--test-email",
                "--auth",
                "./private/email_auth.yaml",
                "--message",
                "./private/message.html",
                "--people",
                "./private/people.yaml",
                "--show",
                "--output",
                "./private/output.txt",
                "--force",
                "-vvv",
                "--quiet",
            ],
            "cwd": "${workspaceFolder}",
            "env": {
                "RONDE_DE_CADEAUX_DEBUG": "1",
            },
        },
    ]
}