{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Ronde de Cadeaux",
            "type": "debugpy",
            "request": "launch",
            "module": "ronde_de_cadeaux",
            "args": [
                "--help",
                "--test-email",
                "--email-config",
                "./private/email_auth.yaml",
                "--message",
                "./private/message.html",
                "--people",
                "./private/people.yaml",
                "--show",
                "--output",
                "./private/output.txt",
                "--overwrite",
                "--verbose",
                "--quiet",
            ],
            "cwd": "${workspaceFolder}",
            "env": {
                "RONDE_DEBUG": "1",
                "RONDE_LANG": "de",
            },
        },
    ]
}