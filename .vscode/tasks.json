{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Clean",
            "type": "shell",
            "command": "${command:python.interpreterPath}",
            "args": [
                "${workspaceFolder}/scripts/clean.py",
            ],
            "problemMatcher": [],
        },
        {
            "label": "Cog the readmes!",
            "type": "shell",
            "command": "uv",
            "args": [
                "run",
                "cog",
                "-r",
                "-P",
                "-c",
                "./README*",
            ],
            "options": {
                "cwd": "${workspaceFolder}",
            },
            "problemMatcher": [],
        },
        {
            "label": "Build package",
            "type": "shell",
            "command": "uv",
            "args": [
                "build",
            ],
            "options": {
                "cwd": "${workspaceFolder}",
            },
            "problemMatcher": [],
        },
        {
            "label": "Upload to PyPI",
            "type": "shell",
            "command": "${command:python.interpreterPath}",
            "args": [
                "-m",
                "twine",
                "upload",
                "--password",
                "${input:pypi_token}",
                "dist/*",
                "--verbose",
            ],
            "options": {
                "cwd": "${workspaceFolder}",
            },
            "problemMatcher": [],
        },
        {
            "label": "Upload to Test PyPI",
            "type": "shell",
            "command": "${command:python.interpreterPath}",
            "args": [
                "-m",
                "twine",
                "upload",
                "--repository",
                "testpypi",
                "--password",
                "${input:test_pypi_token}",
                "dist/*",
            ],
            "options": {
                "cwd": "${workspaceFolder}",
            },
            "problemMatcher": [],
        },
        {
            "label": "Extract i18n (pybabel)",
            "type": "shell",
            "command": "uv",
            "args": [
                "run",
                "pybabel",
                "extract",
                "--input-dirs",
                "ronde_de_cadeaux/",
                "--output-file",
                "ronde_de_cadeaux/locale/ronde.pot",
                "--no-wrap",
                "--omit-header",
                "--no-location",
            ],
            "options": {
                "cwd": "${workspaceFolder}",
            },
            "problemMatcher": [],
        },
        {
            "label": "Update i18n (pybabel)",
            "type": "shell",
            "command": "uv",
            "args": [
                "run",
                "pybabel",
                "update",
                "--input-file",
                "ronde_de_cadeaux/locale/ronde.pot",
                "--output-dir",
                "ronde_de_cadeaux/locale/",
                "--no-wrap",
                "--ignore-pot-creation-date",
            ],
            "options": {
                "cwd": "${workspaceFolder}",
            },
            "problemMatcher": [],
        },
        {
            "label": "Compile i18n (pybabel)",
            "type": "shell",
            "command": "uv",
            "args": [
                "run",
                "pybabel",
                "compile",
                "--directory",
                "ronde_de_cadeaux/locale/",
                "--domain",
                "messages i18nparse_patch",
            ],
            "options": {
                "cwd": "${workspaceFolder}",
            },
            "problemMatcher": [],
        },
    ],
    "inputs": [
        {
            "id": "pypi_token",
            "description": "API token",
            "type": "promptString",
            "password": true,
        },
        {
            "id": "test_pypi_token",
            "description": "API token",
            "type": "promptString",
            "password": true,
        },
        {
            "id": "locale",
            "description": "2-letter code",
            "type": "promptString",
        },
    ],
}