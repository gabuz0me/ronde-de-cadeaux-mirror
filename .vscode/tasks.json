{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build package",
            "type": "shell",
            "command": "${command:python.interpreterPath}",
            "args": [
                "-m",
                "build",
            ],
            "problemMatcher": [],
        },
        {
            "label": "Upload to Test PyPI",
            "command": "${command:python.interpreterPath}",
            "args": [
                "-m",
                "twine",
                "upload",
                "--repository",
                "testpypi",
                "--password",
                "${input:token}",
                "dist/*",
            ],
            "problemMatcher": [],
        },
    ],
    "inputs": [
        {
            "id": "token",
            "description": "API token",
            "type": "promptString"
        }
    ]
}