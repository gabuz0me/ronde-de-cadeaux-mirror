{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Cog the readmes!",
            "type": "shell",
            "command": "uv",
            "args": [
                "run",
                "cog",
                "-r",
                "-P",
                "-c",
                "./README*",
            ],
            "problemMatcher": [],
        },
        {
            "label": "Build package",
            "type": "shell",
            "command": "${command:python.interpreterPath}",
            "args": [
                "-m",
                "build",
            ],
            "problemMatcher": [],
        },
        {
            "label": "Upload to PyPI",
            "type": "shell",
            "command": "${command:python.interpreterPath}",
            "args": [
                "-m",
                "twine",
                "upload",
                // "--repository",
                // "testpypi",
                "--password",
                "${input:token}",
                "dist/*",
            ],
            "problemMatcher": [],
        },
    ],
    "inputs": [
        {
            "id": "token",
            "description": "API token",
            "type": "promptString"
        }
    ]
}